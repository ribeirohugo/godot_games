# MSIX package settings for the Microsoft Store, used by export-msix.bat.
# Copy the values from Partner Center > your app > Product management > Product identity.
# Write values without quotes.

# Package/Identity/Name (taken from the React Native app's Package.appxmanifest)
IDENTITY_NAME=WebPlatinum.OldFlags
# Package/Identity/Publisher (starts with CN=)
PUBLISHER=CN=33F06A6D-7BDD-48EE-AC03-85FC626020AD
# Package/Properties/PublisherDisplayName
PUBLISHER_DISPLAY_NAME=Web Platinum
# The reserved app name (must match one of the names reserved in Partner Center)
DISPLAY_NAME=Old Flags
DESCRIPTION=Guess which empire, kingdom or state each historical flag belonged to.

# Raise this for every Store upload. The last number must stay 0.
VERSION=1.0.0.0

# Tile background behind the logo (transparent, or a color like #F3E9D2).
BACKGROUND_COLOR=transparent
# Languages the package declares, comma separated. Each one needs a Store listing in Partner Center.
# The game itself has English and Portuguese.
LANGUAGES=en,pt
