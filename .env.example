# Example settings for local development.
# Copy this file to .env (same folder) and change the values for your machine.
# The .bat scripts in every game folder read .env from here.
# Write values without quotes and without spaces around "=".

# Full path to the Godot editor executable.
GODOT=C:\etc\godot\Godot_v4.7.2-stable_mono_win64\Godot_v4.7.2-stable_mono_win64.exe

# Godot version, used to find the export templates (e.g. 4.7.2).
GODOT_VERSION=4.7.2

# Android / Amazon Appstore (export-amazon.bat). The Android SDK path is set in the Godot editor
# (Editor Settings > Export > Android > Android SDK Path). Set JAVA_HOME to a JDK 17 if java is not on PATH.
# Keep the keystore outside the repo and back it up: every update must be signed with the same key.
ANDROID_KEYSTORE=C:\Users\me\keystores\webplatinum-release.keystore
ANDROID_KEYSTORE_USER=webplatinum
ANDROID_KEYSTORE_PASSWORD=change-me
#JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.20.8-hotspot
