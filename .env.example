# Example settings for local development.
# Copy this file to .env (same folder) and change the values for your machine.
# The .bat scripts in every game folder read .env from here.
# Write values without quotes and without spaces around "=".

# Full path to the Godot editor executable.
GODOT=C:\etc\godot\Godot_v4.7.2-stable_mono_win64\Godot_v4.7.2-stable_mono_win64.exe

# Godot version, used to find the export templates (e.g. 4.7.2).
GODOT_VERSION=4.7.2
