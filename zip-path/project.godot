; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zip Path"
run/main_scene="res://common/intro/intro.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[display]

window/size/viewport_width=700
window/size/viewport_height=940
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="ZipPath"

[rendering]

environment/defaults/default_clear_color=Color(0.957, 0.949, 0.933, 1)
